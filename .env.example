# Sao chép thành .env khi chạy ở máy. Trên iNET cPanel, khai báo các biến này trong "Setup Node.js App".
PORT=3000
NODE_ENV=production
# Tên miền chính thức (dùng cho sitemap, canonical)
SITE_URL=https://mocnhiencontent.vn
# URL Web App của Google Apps Script (kết thúc bằng /exec)
GOOGLE_SCRIPT_URL=
# Chuỗi bí mật, phải giống SECRET trong google-apps-script/Code.gs
GOOGLE_SCRIPT_SECRET=
