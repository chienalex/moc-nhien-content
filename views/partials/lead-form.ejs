<%# Form đăng ký cho một dịch vụ. Cần biến: service %>
<form class="lead-form" action="/api/dang-ky" method="post" novalidate data-lead-form>
  <input type="hidden" name="service" value="<%= service.slug %>">
  <input type="hidden" name="page" value="/dich-vu/<%= service.slug %>">
  <div class="hp" aria-hidden="true">
    <label for="website-<%= service.slug %>">Website</label>
    <input id="website-<%= service.slug %>" name="website" type="text" tabindex="-1" autocomplete="off">
  </div>

  <div class="form-head">
    <p class="eyebrow">Đăng ký dịch vụ</p>
    <h3 class="form-title"><%= service.name %></h3>
    <p class="form-sub">Điền thông tin, Mộc Nhiên sẽ liên hệ tư vấn và báo giá riêng cho bạn.</p>
  </div>

  <div class="field-row">
    <div class="field" data-field="name">
      <label for="name">Họ và tên <span class="req" aria-hidden="true">*</span></label>
      <input id="name" name="name" type="text" autocomplete="name" required minlength="2" maxlength="80" aria-describedby="name-error" placeholder="Nguyễn Văn A">
      <p class="field-error" id="name-error" role="alert"></p>
    </div>
    <div class="field" data-field="phone">
      <label for="phone">Số điện thoại / Zalo <span class="req" aria-hidden="true">*</span></label>
      <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required maxlength="16" aria-describedby="phone-error" placeholder="0964 646 205">
      <p class="field-error" id="phone-error" role="alert"></p>
    </div>
  </div>

  <div class="field" data-field="industry">
    <label for="industry">Lĩnh vực bạn đang làm <span class="req" aria-hidden="true">*</span></label>
    <div class="select-wrap">
      <select id="industry" name="industry" required aria-describedby="industry-error" data-industry>
        <option value="" selected disabled>Chọn lĩnh vực</option>
        <% industries.forEach(function (i) { %><option value="<%= i %>"><%= i %></option><% }) %>
      </select>
    </div>
    <p class="field-error" id="industry-error" role="alert"></p>
  </div>

  <div class="field" data-field="industryOther" data-industry-other hidden>
    <label for="industryOther">Lĩnh vực của bạn là gì?</label>
    <input id="industryOther" name="industryOther" type="text" maxlength="80" aria-describedby="industryOther-error" placeholder="Ví dụ: đồ handmade, phụ tùng xe máy…">
    <p class="field-error" id="industryOther-error" role="alert"></p>
  </div>

  <fieldset class="field" data-field="choices" aria-describedby="choices-error">
    <legend><%= service.form.choiceLabel %> <span class="req" aria-hidden="true">*</span> <span class="legend-hint">(chọn một hoặc nhiều)</span></legend>
    <div class="chips">
      <% service.form.choices.forEach(function (c, i) { %>
        <label class="chip">
          <input type="checkbox" name="choices" value="<%= c %>">
          <span class="chip-box"><%- icon('check', 'icon chip-check') %><%= c %></span>
        </label>
      <% }) %>
    </div>
    <p class="field-error" id="choices-error" role="alert"></p>
  </fieldset>

  <% if (service.form.extraOptions) { %>
  <fieldset class="field" data-field="extra" aria-describedby="extra-error">
    <legend><%= service.form.extraLabel %> <span class="req" aria-hidden="true">*</span></legend>
    <div class="chips">
      <% service.form.extraOptions.forEach(function (o) { %>
        <label class="chip chip-radio">
          <input type="radio" name="extra" value="<%= o %>">
          <span class="chip-box"><%= o %></span>
        </label>
      <% }) %>
    </div>
    <p class="field-error" id="extra-error" role="alert"></p>
  </fieldset>
  <% } %>

  <div class="field" data-field="note">
    <label for="note">Ghi chú thêm <span class="optional">(không bắt buộc)</span></label>
    <textarea id="note" name="note" rows="3" maxlength="500" placeholder="Sản phẩm, mục tiêu, link Fanpage…"></textarea>
  </div>

  <div class="form-foot">
    <button class="btn btn-primary btn-lg btn-submit" type="submit" data-submit>
      <span class="btn-label">Gửi đăng ký</span>
      <span class="spinner" aria-hidden="true"></span>
      <%- icon('arrow') %>
    </button>
    <p class="form-privacy">Thông tin chỉ dùng để Mộc Nhiên liên hệ tư vấn, không chia sẻ cho bên thứ ba.</p>
  </div>
  <p class="form-status" role="status" aria-live="polite" data-form-status></p>
</form>

<div class="form-success" hidden tabindex="-1" data-form-success>
  <div class="success-icon"><%- icon('check') %></div>
  <h3>Mộc Nhiên đã nhận thông tin!</h3>
  <p>Cảm ơn bạn. Mộc Nhiên sẽ liên hệ qua Zalo hoặc điện thoại trong thời gian sớm nhất để tư vấn chi tiết.</p>
  <a class="btn btn-ghost" href="<%= site.zalo %>" target="_blank" rel="noopener">Nhắn Zalo ngay</a>
</div>
