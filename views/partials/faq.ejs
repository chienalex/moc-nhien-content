<section class="section faq" aria-labelledby="faq-title">
  <div class="container faq-grid">
    <div class="faq-intro reveal">
      <p class="eyebrow">Câu hỏi thường gặp</p>
      <h2 class="h2" id="faq-title">Bạn đang băn khoăn?</h2>
      <p class="lead">Chưa thấy câu trả lời? Nhắn Zalo <a class="text-link" href="<%= site.zalo %>" target="_blank" rel="noopener"><%= site.phoneDisplay %></a> — Mộc Nhiên trả lời trực tiếp.</p>
    </div>
    <div class="faq-list">
      <% faqs.forEach(function (f) { %>
        <details class="faq-item reveal">
          <summary><span><%= f.q %></span><%- icon('plus', 'icon faq-icon') %></summary>
          <div class="faq-answer"><p><%= f.a %></p></div>
        </details>
      <% }) %>
    </div>
  </div>
</section>
